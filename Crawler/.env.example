# 로컬 개발용 환경변수 예시 파일
# 실제 값은 .env 파일에 작성한다 (.env는 git에 커밋하지 않음)
# k8s 클러스터에서는 같은 키를 ConfigMap/Secret으로 주입한다

# 수집 대상 컬렉션: best(베스트) 또는 sales(할인)
CRAWL_TARGET=best

# Kafka 브로커 주소와 상품 데이터를 전송할 토픽 (로컬: localhost:9092 / k8s: 서비스 주소로 주입)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PRODUCT_TOPIC=crawled-products

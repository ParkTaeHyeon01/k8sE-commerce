# 로컬 개발용 환경변수 예시 파일
# 실제 값은 .env 파일에 작성한다 (.env는 git에 커밋하지 않음)
# k8s 클러스터에서는 같은 키를 ConfigMap/Secret으로 주입한다

# Kafka 브로커 주소, 구독할 토픽, 컨슈머 그룹 (Crawler의 producer 설정과 짝을 이룬다)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PRODUCT_TOPIC=crawled-products
KAFKA_CONSUMER_GROUP=product-loader

# MongoDB 접속 정보 (비밀번호에 특수문자가 있으면 URL 인코딩 필요 - 예: # -> %23)
MONGODB_URI=mongodb://admin:k8spass%23@localhost:27017/?authSource=admin
MONGODB_DB=ecommerce

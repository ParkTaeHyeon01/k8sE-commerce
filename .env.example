# 로컬 개발용 환경변수 예시 — 이 파일을 복사해 .env로 만든 뒤 값을 채운다
# k8s 클러스터에서는 같은 키를 ConfigMap/Secret으로 주입한다

# 수집 대상: best(베스트) 또는 sales(할인)
CRAWL_TARGET=best

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PRODUCT_TOPIC=crawled-products
KAFKA_CONSUMER_GROUP=product-loader

# MongoDB (비밀번호에 특수문자 있으면 URL 인코딩 필요 - 예: # -> %23)
# 인증 없는 로컬: mongodb://localhost:27017/
# 인증 있는 로컬: mongodb://admin:k8spass%23@localhost:27017/?authSource=admin
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=ecommerce

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60

# Product gRPC 서버
PRODUCT_GRPC_PORT=50051

# Gateway
PRODUCT_GRPC_ADDR=localhost:50051
CORS_ORIGINS=http://localhost:5173
